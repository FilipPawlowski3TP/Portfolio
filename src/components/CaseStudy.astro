---
import CaseStudyScroll from '../islands/CaseStudyScroll';
import { caseStudy } from '../data/content';
---

<section id="case-study" class="relative pb-8 pt-28 lg:pt-32">
  <div class="shell">
    <!-- Nagłówek sekcji -->
    <div class="flex items-center gap-4" data-reveal>
      <span class="label">01</span>
      <span class="h-px w-10 bg-accent"></span>
      <span class="label">{caseStudy.label}</span>
    </div>

    <h2 class="mt-7 max-w-4xl text-display-l font-medium">
      <span class="mask-line"><span class="block" data-mask-line>{caseStudy.title} —</span></span>
      <span class="mask-line">
        <span class="block font-serif italic text-muted" data-mask-line>{caseStudy.subtitle}</span>
      </span>
    </h2>

    <div class="mt-10 grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
      <p class="max-w-prose text-lg leading-relaxed text-muted lg:col-span-7" data-reveal>
        {caseStudy.narrative}
      </p>

      <dl class="grid grid-cols-1 gap-px border-t border-line sm:grid-cols-2 lg:col-span-5" data-reveal>
        {
          caseStudy.meta.map((item) => (
            <div class="flex flex-col gap-1.5 border-b border-line py-5 pr-6">
              <dt class="label !tracking-[0.16em]">{item.label}</dt>
              <dd class="text-[0.9375rem] leading-relaxed text-ink">{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <!-- Wyspa: przypięty, poziomy scroll z realnymi makiety stron klienta -->
  <CaseStudyScroll client:load screens={caseStudy.screens} outcomes={caseStudy.outcomes} cta={caseStudy.cta} />
</section>
