---
import ContactForm from '../islands/ContactForm';
import { contact, site } from '../data/content';
---

<section id="kontakt" class="relative py-28 lg:py-32">
  <div class="shell">
    <!-- Nagłówek -->
    <div class="flex items-center gap-4" data-reveal>
      <span class="label">03</span>
      <span class="h-px w-10 bg-accent"></span>
      <span class="label">{contact.label}</span>
    </div>

    <h2 class="mt-7 max-w-4xl text-display-l font-medium">
      {
        contact.heading.map((line) => (
          <span class="mask-line">
            <span class="block" data-mask-line>
              {line.map((segment) => (segment.accent ? <span class="font-serif italic">{segment.text}</span> : segment.text))}
            </span>
          </span>
        ))
      }
    </h2>

    <div class="mt-16 grid grid-cols-1 gap-14 lg:grid-cols-12 lg:gap-20">
      <!-- Dane kontaktowe -->
      <div class="flex flex-col gap-10 lg:col-span-5">
        <p class="max-w-prose text-lg leading-relaxed text-muted" data-reveal>
          {contact.lead}
        </p>

        <div class="flex flex-col gap-8">
          <a href={`mailto:${site.email}`} class="group flex items-center gap-5" data-reveal>
            <span
              class="flex h-12 w-12 items-center justify-center border border-line transition-colors duration-500 ease-swift group-hover:border-accent group-hover:text-accent"
            >
              <svg class="h-[1.125rem] w-[1.125rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="1"></rect>
                <path d="m3 7 9 6 9-6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
            <span class="flex flex-col gap-1">
              <span class="label !tracking-[0.16em]">E-mail</span>
              <span class="text-lg text-ink transition-colors duration-300 group-hover:text-accent">{site.email}</span>
            </span>
          </a>

          <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="group flex items-center gap-5" data-reveal>
            <span
              class="flex h-12 w-12 items-center justify-center border border-line transition-colors duration-500 ease-swift group-hover:border-accent group-hover:text-accent"
            >
              <svg class="h-[1.125rem] w-[1.125rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path
                  d="M5 4h4l2 5-2.5 1.5a12 12 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </span>
            <span class="flex flex-col gap-1">
              <span class="label !tracking-[0.16em]">Telefon</span>
              <span class="text-lg text-ink transition-colors duration-300 group-hover:text-accent">{site.phone}</span>
            </span>
          </a>

          <div class="flex items-center gap-5" data-reveal>
            <span class="flex h-12 w-12 items-center justify-center border border-line">
              <svg class="h-[1.125rem] w-[1.125rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z" stroke-linecap="round" stroke-linejoin="round"></path>
                <circle cx="12" cy="10" r="2.5"></circle>
              </svg>
            </span>
            <span class="flex flex-col gap-1">
              <span class="label !tracking-[0.16em]">Lokalizacja</span>
              <span class="text-lg text-ink">{site.location}</span>
            </span>
          </div>
        </div>

        <div class="border-t border-line pt-8" data-reveal>
          <div class="flex items-center gap-3">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-pulse-soft rounded-full bg-accent"></span>
            </span>
            <span class="label !tracking-[0.18em]">{site.availability}</span>
          </div>
          <p class="mt-4 max-w-md text-sm leading-relaxed text-muted">{contact.note}</p>
        </div>
      </div>

      <!-- Formularz (wyspa React) -->
      <div class="lg:col-span-7">
        <ContactForm client:visible endpoint={contact.endpoint} />
      </div>
    </div>
  </div>
</section>
