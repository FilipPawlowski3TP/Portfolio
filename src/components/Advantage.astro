---
import { advantage } from '../data/content';
---

<section id="przewaga" class="relative border-y border-line bg-surface/40 py-28 lg:py-32">
  <div class="shell">
    <!-- Nagłówek -->
    <div class="flex items-center gap-4" data-reveal>
      <span class="label">02</span>
      <span class="h-px w-10 bg-accent"></span>
      <span class="label">{advantage.label}</span>
    </div>

    <h2 class="mt-7 max-w-4xl text-display-l font-medium">
      {
        advantage.heading.map((line) => (
          <span class="mask-line">
            <span class="block" data-mask-line>
              {line.map((segment) => (segment.accent ? <span class="font-serif italic">{segment.text}</span> : segment.text))}
            </span>
          </span>
        ))
      }
    </h2>

    <p class="mt-8 max-w-prose text-lg leading-relaxed text-muted" data-reveal>
      {advantage.lead}
    </p>

    <!-- Porównanie -->
    <div class="mt-16 grid grid-cols-1 gap-px lg:grid-cols-2">
      <div class="flex flex-col gap-7 border border-line p-8 lg:p-10" data-reveal>
        <div class="flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center border border-line text-muted">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round"></path>
            </svg>
          </span>
          <h3 class="text-display-s font-medium text-muted">{advantage.comparison.theirs.title}</h3>
        </div>
        <ul class="flex flex-col">
          {
            advantage.comparison.theirs.items.map((item) => (
              <li class="flex items-start gap-4 border-b border-line py-4 text-sm leading-relaxed text-muted last:border-b-0">
                <span class="mt-2 h-px w-5 shrink-0 bg-muted/50" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="relative flex flex-col gap-7 border border-accent/30 bg-accent/[0.03] p-8 lg:p-10"
        data-reveal
      >
        <div class="flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center border border-accent text-accent">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path d="M5 12.5 10 17.5 19 7" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
          <h3 class="text-display-s font-medium">{advantage.comparison.ours.title}</h3>
        </div>
        <ul class="flex flex-col">
          {
            advantage.comparison.ours.items.map((item) => (
              <li class="flex items-start gap-4 border-b border-line py-4 text-sm leading-relaxed text-ink last:border-b-0">
                <span class="mt-2 h-px w-5 shrink-0 bg-accent" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Proces -->
    <div class="mt-24">
      <div class="flex items-center gap-4" data-reveal>
        <span class="label">{advantage.processLabel}</span>
        <span class="h-px flex-1 bg-line"></span>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-px border-t border-line sm:grid-cols-2 lg:grid-cols-4">
        {
          advantage.process.map((step) => (
            <article
              class="group flex flex-col gap-5 border-b border-line py-9 pr-8 lg:border-l lg:border-line lg:pl-8 lg:first:border-l-0 lg:first:pl-0"
              data-reveal
            >
              <span class="font-serif text-3xl italic text-muted transition-colors duration-500 ease-swift group-hover:text-accent">
                {step.num}
              </span>
              <h3 class="text-display-s font-medium">{step.title}</h3>
              <p class="text-sm leading-relaxed text-muted">{step.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
